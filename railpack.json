{
  "$schema": "https://railway.com/railpack.schema.json",
  "version": "1",
  "metadata": {
    "name": "glide-vscode-server",
    "description": "VS Code fork with Gide AI coding agent extension"
  },
  "build": {
    "provider": "docker",
    "dockerfile": "Dockerfile"
  },
  "deploy": {
    "startCommand": "node scripts/railway-vscode-server.mjs",
    "healthCheckPath": "/api/health",
    "healthCheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3,
    "overlapSeconds": 30,
    "drainingSeconds": 15,
    "replicaCount": 1,
    "resourceLimits": {
      "memory": "2Gi",
      "cpu": "1000m"
    }
  }
}
