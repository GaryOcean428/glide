{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "buildCommand": "yarn install --frozen-lockfile && chmod +x scripts/railway-vscode-server.mjs",
    "watchPatterns": [
      "src/**",
      "extensions/**",
      "scripts/**"
    ]
  },
  "deploy": {
    "startCommand": "node scripts/railway-vscode-server.mjs",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 300,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 3
  }
}
